import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner ob=new Scanner(System.in);
		String s="indu";
		for(int i=0;i<=s.length()-1;i++){
		    char c=s.charAt(i);
		    int co=0;
		    for(int j=0;j<=s.length()-1;j++){
		        if(s.charAt(j)==c){
		            co++;
		        }
		    }
		    System.out.println(c+":"+co);
		}
}
}
