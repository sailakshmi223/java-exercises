import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner ob=new Scanner(System.in);
		int a[]={1,3,4};
		int max=a[0];
		for(int i=0;i<a.length;i++){
		    if(a[i]>max){
		        max=a[i];
		    }
		}
		for(int i=0;i<a.length;i++){
		    if(max==a[i]){
		        a[i]=0;
		    }
		}
		int maxi=a[0];
		for(int i=0;i<a.length;i++){
		    if(a[i]>maxi){
		        maxi=a[i];
		    }
		}
		System.out.print(maxi);
	}
}
