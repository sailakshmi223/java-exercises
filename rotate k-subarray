public class Main
{
	public static void main(String[] args) {
		int a[]={1,2,3,4,5};
		int n=a.length;
		int k1=2;
		for(int j=1;j<=k1;j++){
		    int ld=a[n-1];
		    for(int i=n-1;i>0;i--){
		        a[i]=a[i-1];
		    }
		    a[0]=ld;
		}
		for(int k=0;k<n;k++){
		    System.out.print(a[k]+" ");
		}
	}
}
