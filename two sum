import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner ob=new Scanner(System.in);
		int n=ob.nextInt();
		int a[]=new int[n];
		for(int i=0;i<n;i++){
		    a[i]=ob.nextInt();
		}
		int tar=ob.nextInt();
		int b[]=new int[2];
		for(int i=0;i<n;i++){
		    if((a[i]+a[i+1])==tar){
		        b[0]=i;
		        b[1]=i+1;
		        break;
		    }
		   
		}
		for(int i=0;i<2;i++){
		    System.out.print(b[i]+" ");
		}
	}
}
